<Page x:Class="TimeActivity.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
      Title="统计报表">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：日/周/月切换 + 日期范围导航 + 分类筛选 + 空闲过滤 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RbDay" Content="日" Width="48" Height="28" VerticalAlignment="Center" Margin="0,0,4,0"
                         Checked="RbPeriod_Checked" Tag="day"/>
            <RadioButton x:Name="RbWeek" Content="周" Width="48" Height="28" VerticalAlignment="Center" Margin="0,0,4,0"
                         Checked="RbPeriod_Checked" Tag="week"/>
            <RadioButton x:Name="RbMonth" Content="月" Width="48" Height="28" VerticalAlignment="Center" Margin="0,0,16,0"
                         Checked="RbPeriod_Checked" Tag="month"/>

            <Button x:Name="BtnPrev" Content="◀" Width="32" Height="28" Click="BtnPrev_Click"/>
            <TextBlock x:Name="RangeText" Text="" VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" TextAlignment="Center" FontSize="13"/>
            <Button x:Name="BtnNext" Content="▶" Width="32" Height="28" Click="BtnNext_Click"/>
            <Button x:Name="BtnThis" Content="本期" Width="56" Height="28" Margin="8,0,0,0" Click="BtnThis_Click" FontSize="12"/>

            <TextBlock Text="筛选:" VerticalAlignment="Center" Margin="16,0,4,0" FontSize="12" Foreground="#888"/>
            <ComboBox x:Name="CategoryFilter" Width="120" Height="28" FontSize="12" SelectionChanged="CategoryFilter_SelectionChanged"/>
            <CheckBox x:Name="ChkSkipIdle" Content="跳过空闲时段" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Checked="ChkSkipIdle_Changed" Unchecked="ChkSkipIdle_Changed"/>
        </StackPanel>

        <!-- 统计内容区（可滚动） -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 总览：总活跃时长 + 日均等补充信息 -->
                <Border Background="#F8F8F8" CornerRadius="6" Padding="16,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TotalText" Text="总活跃时长：0h0m" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DetailText" Text="" FontSize="13" Foreground="#666" Margin="24,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 类别占比（条形图）：每个分类一行，色条 + 时长 + 百分比 -->
                <Border x:Name="CategorySection" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="类别占比" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel x:Name="CategoryBarsPanel"/>
                    </StackPanel>
                </Border>

                <!-- 每日活跃趋势（折线图，仅周/月模式显示） -->
                <Border x:Name="TrendSection" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="每日活跃趋势" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <Canvas x:Name="TrendCanvas" Height="120" ClipToBounds="True" SizeChanged="TrendCanvas_SizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- Top 应用排行（按时长降序，最多 15 个） -->
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Top 应用" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel x:Name="TopAppsPanel"/>
                    </StackPanel>
                </Border>

                <!-- AI 总结区域：Markdown 渲染 + 手动生成按钮 -->
                <Border BorderBrush="#4A90D9" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="AITitle" Text="AI 每日总结" FontWeight="Bold" FontSize="14" Foreground="#4A90D9"/>
                            <TextBlock x:Name="AISummaryTime" Text="" FontSize="12" Foreground="#999" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="BtnGenerateAI" Content="生成总结" Width="80" Height="26" FontSize="11" Margin="12,0,0,0" Background="#4A90D9" Foreground="White" Click="BtnGenerateAI_Click"/>
                        </StackPanel>
                        <mdxaml:MarkdownScrollViewer x:Name="AISummaryText" Markdown="点击「生成总结」获取 AI 分析..." FontSize="13" Foreground="#555" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="AISummaryText_PreviewMouseWheel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
