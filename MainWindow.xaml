<!-- ============================================================================
MainWindow.xaml — 主窗口布局
结构（4 行 Grid）：
  Row0 顶部状态栏：当前活动 / 类别 / 今日总时长
  Row1 控制按钮区：开始/停止/刷新/设置
  Row2 主内容 TabControl：Tab1 时间轴页（日期导航+缩放+配色+画布+列表），
       Tab2 统计报表页（Frame 承载 StatisticsPage）
  Row3 底部状态栏：ShowStatus 的临时提示
另含 Popup 浮动详情框（时间轴悬停显示活动详情与截图）。
事件处理器实现见 MainWindow*.cs 各部分类。
============================================================================ -->
<!-- 根元素 Window：d:/mc 命名空间仅供设计器使用（mc:Ignorable 忽略设计时属性）；启动位置屏幕居中 -->
<Window x:Class="TimeActivity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeActivity"
        mc:Ignorable="d"
        Title="TimeActivity — 屏幕时间追踪" Height="720" Width="960"
        WindowStartupLocation="CenterScreen">
    <!-- 根布局 Grid：整体四周留白 12px -->
    <Grid Margin="12">
        <!-- 四行定义：状态栏/按钮区自适应高度，主内容区占满剩余空间 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶部状态栏 -->
            <RowDefinition Height="Auto"/> <!-- 控制按钮区 -->
            <RowDefinition Height="*"/>    <!-- 主内容区（自适应高度） -->
            <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部状态栏：显示当前活动、类别、今日活跃时长 -->
        <Border Grid.Row="0" Background="#F0F0F0" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="当前：" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="未开始" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="14"/>
                <TextBlock Text="类别：" FontWeight="Bold" VerticalAlignment="Center" Margin="24,0,0,0"/>
                <TextBlock x:Name="CategoryText" Text="—" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="14"/>
                <!-- 今日/当日活跃总时长（灰色小字，由 UpdateTodayTotal 更新） -->
                <TextBlock x:Name="TodayTotalText" Text="" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="14" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- 控制按钮区：开始/停止追踪、刷新、设置 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <!-- 开始追踪：Click 由 Tracking 部分类处理 -->
            <Button x:Name="BtnStart" Content="开始追踪" Width="100" Height="32" Margin="0,0,8,0" Click="BtnStart_Click"/>
            <!-- 停止追踪：默认禁用（未在追踪时不可点） -->
            <Button x:Name="BtnStop" Content="停止追踪" Width="100" Height="32" Margin="0,0,8,0" Click="BtnStop_Click" IsEnabled="False"/>
            <!-- 刷新：按当前日期重载数据 -->
            <Button x:Name="BtnRefresh" Content="刷新" Width="80" Height="32" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <!-- 设置：打开模态设置窗口 -->
            <Button x:Name="BtnSettings" Content="⚙ 设置" Width="80" Height="32" Margin="0,0,8,0" Click="BtnSettings_Click"/>
        </StackPanel>

        <!-- 主内容区：Tab 切换 -->
        <TabControl Grid.Row="2" TabStripPlacement="Top">
            <!-- Tab 1: 时间轴页 -->
            <TabItem Header="时间轴">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 日期切换 + 缩放信息 + 配色模式选择 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#F0F0F0" CornerRadius="4"><!-- 日期导航组 -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnPrevDay" Content="◀" Width="32" Height="28" Background="Transparent" BorderThickness="0" Click="BtnPrevDay_Click"/> <!-- 前一天 -->
                                <TextBlock x:Name="DateText" Text="今天" VerticalAlignment="Center" HorizontalAlignment="Center" Width="100" TextAlignment="Center" FontSize="14"/> <!-- 日期显示 -->
                                <Button x:Name="BtnNextDay" Content="▶" Width="32" Height="28" Background="Transparent" BorderThickness="0" Click="BtnNextDay_Click"/> <!-- 后一天 -->
                                <Button x:Name="BtnToday" Content="今天" Width="48" Height="28" Background="Transparent" BorderThickness="0,0,1,0" Click="BtnToday_Click" FontSize="12"/> <!-- 回到今天 -->
                            </StackPanel>
                        </Border>
                        <!-- 当前缩放倍数显示（随滚轮缩放实时更新） -->
                        <TextBlock x:Name="ZoomText" Text="缩放：1x" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11" Foreground="#999"/>
                        <!-- 配色模式切换组：按类别 / 按应用着色 -->
                        <Border Background="#F0F0F0" CornerRadius="4" Margin="12,0,0,0" Padding="8,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="配色：" FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
                                <!-- 按分类着色（默认选中），Checked 触发模式切换 -->
                                <RadioButton x:Name="RbColorCategory" Content="类别" IsChecked="True" Margin="4,0" FontSize="11" Checked="ColorMode_Changed"/>
                                <!-- 按应用着色 -->
                                <RadioButton x:Name="RbColorApp" Content="应用" Margin="4,0" FontSize="11" Checked="ColorMode_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 时间轴 + 活动列表容器 -->
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 时间轴区域：刻度 + 主时间轴 + 概览条 + 图例 -->
                            <StackPanel x:Name="TimelineContainer" Grid.Row="0" Margin="0,0,0,8">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="时间轴" FontWeight="Bold" DockPanel.Dock="Left"/>
                                </DockPanel>

                                <!-- 上方时间刻度画布 -->
                                <Canvas x:Name="TopScaleCanvas" Height="18" Margin="0,0,0,2" ClipToBounds="True"/>
                                <!-- 主时间轴画布：鼠标悬停显示详情、滚轮缩放 -->
                                <Canvas x:Name="MainTimelineCanvas" Height="44" ClipToBounds="True" Background="#F5F5F5"
                                        MouseMove="MainTimelineCanvas_MouseMove" MouseLeave="MainTimelineCanvas_MouseLeave"
                                        PreviewMouseWheel="MainTimelineCanvas_PreviewMouseWheel"/>
                                <!-- 概览条画布：可拖拽平移可见范围 -->
                                <Canvas x:Name="OverviewCanvas" Height="20" Margin="0,4,0,0" ClipToBounds="True"
                                        MouseLeftButtonDown="OverviewCanvas_MouseLeftButtonDown"
                                        MouseMove="OverviewCanvas_MouseMove"
                                        MouseLeftButtonUp="OverviewCanvas_MouseLeftButtonUp"/>
                                <!-- 概览条刻度画布 -->
                                <Canvas x:Name="OverviewScaleCanvas" Height="14" Margin="0,1,0,0" ClipToBounds="True"/>
                                <!-- 分类颜色图例 -->
                                <WrapPanel x:Name="LegendPanel" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- 列表模式切换：使用明细 / 使用占比 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
                                <!-- 明细列表模式（默认选中）：Tag=detail -->
                                <RadioButton x:Name="RbDetailList" Content="使用明细" IsChecked="True" Margin="0,0,12,0" Checked="RbListMode_Checked" Tag="detail"/>
                                <!-- 占比统计模式：Tag=stats，处理器按 Tag 分流视图 -->
                                <RadioButton x:Name="RbStatsList" Content="使用占比" Checked="RbListMode_Checked" Tag="stats"/>
                            </StackPanel>

                            <!-- 使用明细列表：图标 + 应用名 + 标题 + 类别 + 开始/结束/时长 -->
                            <ListView x:Name="ActivityList" Grid.Row="2" FontSize="13"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"> <!-- 虚拟化+回收，保证 500 条流畅 -->
                                <ListView.View>
                                    <GridView>
                                        <!-- 列定义：每列绑定 ActivityDisplayItem 对应属性 -->
                                        <!-- 图标列：DataTemplate 内绑定进程图标 -->
                                        <GridViewColumn Header="" Width="32">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <!-- 应用名列：绑定友好显示名 -->
                                        <GridViewColumn Header="应用" Width="120" DisplayMemberBinding="{Binding DisplayName}"/>
                                        <!-- 标题列：窗口标题 -->
                                        <GridViewColumn Header="标题" Width="300" DisplayMemberBinding="{Binding WindowTitle}"/>
                                        <!-- 类别列：分类名 -->
                                        <GridViewColumn Header="类别" Width="70" DisplayMemberBinding="{Binding Category}"/>
                                        <!-- 开始列：格式 HH:mm:ss -->
                                        <GridViewColumn Header="开始" Width="90" DisplayMemberBinding="{Binding StartTime, StringFormat=HH:mm:ss}"/>
                                        <!-- 结束列：格式 HH:mm:ss -->
                                        <GridViewColumn Header="结束" Width="90" DisplayMemberBinding="{Binding EndTime, StringFormat=HH:mm:ss}"/>
                                        <!-- 时长列：预格式化文本 -->
                                        <GridViewColumn Header="时长" Width="70" DisplayMemberBinding="{Binding DurationText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- 使用占比列表：左列应用统计 + 右列类别统计 -->
                            <Grid x:Name="StatsListPanel" Grid.Row="2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <!-- 三列：左列表 | 分隔条 | 右列表 -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 左列：应用统计（右键可改颜色/类别） -->
                                <DockPanel Grid.Column="0">
                                    <TextBlock Text="应用统计" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <!-- 右键事件挂在 Preview 隧道阶段，先于菜单弹出定位被点击行 -->
                                    <ListView x:Name="AppStatsList" FontSize="12" BorderThickness="0" PreviewMouseRightButtonDown="AppStatsList_PreviewMouseRightButtonUp"/>
                                </DockPanel>
                                <!-- 可拖动分隔条：调整左右两列宽度比例 -->
                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>
                                <!-- 右列：类别统计（右键可改颜色/查看规则） -->
                                <DockPanel Grid.Column="2">
                                    <TextBlock Text="类别统计" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <ListView x:Name="CategoryStatsList" FontSize="12" BorderThickness="0" PreviewMouseRightButtonDown="CategoryStatsList_PreviewMouseRightButtonUp"/>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: 统计报表页（嵌入 Frame 加载 StatisticsPage） -->
            <TabItem Header="统计报表">
                <!-- Frame 承载报表页；隐藏默认导航按钮栏 -->
                <Frame x:Name="StatsFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏：显示临时提示信息 -->
        <TextBlock x:Name="StatusBar" Grid.Row="3" Height="20" FontSize="11" Foreground="#888" Padding="8,0" VerticalAlignment="Center" Text=""/>

        <!-- 跟随鼠标的浮动详情框（Popup）：鼠标悬停时间轴时显示活动详情和截图 -->
        <Popup x:Name="DetailPopup" AllowsTransparency="True" Placement="RelativePoint" PlacementTarget="{Binding ElementName=MainTimelineCanvas}" IsOpen="False" StaysOpen="True">
            <!-- 浮窗外观：白底圆角细边框 -->
            <Border Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="8,5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <!-- 分类色块 -->
                        <Rectangle x:Name="PopupColor" Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <!-- 分类名 · 时长 -->
                        <TextBlock x:Name="PopupCategory" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 起止时间或纯时刻（未命中活动时） -->
                    <TextBlock x:Name="PopupTime" FontSize="11" Foreground="#666"/>
                    <!-- 进程名 -->
                    <TextBlock x:Name="PopupProcess" FontSize="11" Foreground="#333" Margin="0,2,0,0"/>
                    <!-- 窗口标题（超宽省略号截断） -->
                    <TextBlock x:Name="PopupTitle" FontSize="11" Foreground="#999" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    <!-- 截图预览（默认隐藏，命中截图才显示） -->
                    <Image x:Name="PopupScreenshot" Stretch="Uniform" MaxWidth="400" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
