<Page x:Class="TimeActivity.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设置" Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="设置" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel>

                <!-- 追踪设置 -->
                <Expander Header="追踪设置" IsExpanded="True" Margin="0,0,0,8" Background="White" Padding="12,8">
                    <StackPanel Margin="0,8,0,0">
                        <!-- 采样间隔 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="采样间隔" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxSamplingInterval" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="1秒" Tag="1"/>
                                <ComboBoxItem Content="3秒" Tag="3"/>
                                <ComboBoxItem Content="5秒" Tag="5"/>
                                <ComboBoxItem Content="10秒" Tag="10"/>
                                <ComboBoxItem Content="30秒" Tag="30"/>
                            </ComboBox>
                        </Grid>
                        <!-- 空闲阈值 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="空闲阈值" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxIdleThreshold" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="3分钟" Tag="180"/>
                                <ComboBoxItem Content="5分钟" Tag="300"/>
                                <ComboBoxItem Content="10分钟" Tag="600"/>
                                <ComboBoxItem Content="15分钟" Tag="900"/>
                                <ComboBoxItem Content="30分钟" Tag="1800"/>
                            </ComboBox>
                        </Grid>
                        <!-- 启动时自动开始追踪 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动时自动开始追踪" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkAutoStartTracking" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 追踪窗口标题 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="追踪窗口标题" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkTrackWindowTitle" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 截图设置 -->
                <Expander Header="截图设置" IsExpanded="False" Margin="0,0,0,8" Background="White" Padding="12,8">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启用截图" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkEnableScreenshot" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图间隔" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxScreenshotInterval" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="1分钟" Tag="1"/>
                                <ComboBoxItem Content="3分钟" Tag="3"/>
                                <ComboBoxItem Content="5分钟" Tag="5"/>
                                <ComboBoxItem Content="10分钟" Tag="10"/>
                                <ComboBoxItem Content="30分钟" Tag="30"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图质量" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxScreenshotQuality" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="高" Tag="high"/>
                                <ComboBoxItem Content="中" Tag="medium"/>
                                <ComboBoxItem Content="低" Tag="low"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图保存路径" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtScreenshotPath" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button x:Name="BtnBrowsePath" Grid.Column="1" Content="浏览..." HorizontalAlignment="Right" Width="60" Click="BtnBrowsePath_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 显示设置 -->
                <Expander Header="显示设置" IsExpanded="False" Margin="0,0,0,8" Background="White" Padding="12,8">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="24小时制" VerticalAlignment="Center"/>
                            <CheckBox x:Name="Chk24Hour" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxTheme" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="浅色" Tag="light"/>
                                <ComboBoxItem Content="深色" Tag="dark"/>
                                <ComboBoxItem Content="跟随系统" Tag="auto"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 数据设置 -->
                <Expander Header="数据设置" IsExpanded="False" Margin="0,0,0,8" Background="White" Padding="12,8">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据保留天数" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxDataRetention" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="30天" Tag="30"/>
                                <ComboBoxItem Content="90天" Tag="90"/>
                                <ComboBoxItem Content="180天" Tag="180"/>
                                <ComboBoxItem Content="365天" Tag="365"/>
                                <ComboBoxItem Content="永久" Tag="0"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="清空所有数据" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearData" Grid.Column="1" Content="清空..." HorizontalAlignment="Left" Width="80"
                                    Background="#FFE0E0" BorderBrush="#FFCCCC" Click="BtnClearData_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- AI 设置 -->
                <Expander Header="AI 设置" IsExpanded="False" Margin="0,0,0,8" Background="White" Padding="12,8">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启用 AI 总结" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkEnableAI" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API 地址" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtApiUrl" Grid.Column="1" Margin="0,0,8,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API Key" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="TxtApiKey" Grid.Column="1" Margin="0,0,8,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自动生成每日总结" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkAutoSummary" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 系统设置 -->
                <Expander Header="系统设置" IsExpanded="False" Margin="0,0,0,8" Background="White" Padding="12,8">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="开机自启" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkAutoStart" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最小化到托盘" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷键-开始/停止追踪" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHotkey" Grid.Column="1" Width="200" HorizontalAlignment="Left" IsReadOnly="True"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,16">
                    <Button x:Name="BtnSave" Content="保存设置" Width="100" Height="32" Margin="0,0,8,0"
                            Background="#4A90D9" Foreground="White" Click="BtnSave_Click"/>
                    <Button x:Name="BtnCancel" Content="取消" Width="80" Height="32"
                            Click="BtnCancel_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
