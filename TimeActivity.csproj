<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 内存/性能优化配置 -->
    <GCHeapHardLimitPercent>60</GCHeapHardLimitPercent>
    <TieredCompilation>false</TieredCompilation>
    <PublishReadyToRun>false</PublishReadyToRun>
    
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>zh-Hans;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSingleFile>false</IncludeNativeLibrariesForSingleFile>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans;en-US</SatelliteResourceLanguages>
    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- 手动引用 WinForms 仅为了用 NotifyIcon（不开启 UseWindowsForms，避免引入整套 WinForms SDK） -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- 预置规则数据文件复制到输出目录 -->
  <ItemGroup>
    <None Update="Data\seed_rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- tests 目录是独立的测试项目，主项目编译时必须把它排除掉。
       原因：SDK 风格项目默认会把项目目录下所有 **/*.cs 都抓来编译，
       不会因为子目录自带 csproj 就放过它。不排除的话测试代码会被编进
       主程序，然后因为找不到 xunit 类型直接报错。
       写 tests\** 而不是逐个文件排除，以后再加测试项目不用改这里。 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

</Project>
