<!-- ============================================================================
App.xaml — WPF 应用入口声明
- x:Class 指向 App 类（启动流程在 App.xaml.cs 的 OnStartup）；
- 2026-08-23 方案A：移除 StartupUri，改由代码决定是否/何时创建 MainWindow ——
  开机自启（带 minimized 参数）时只驻留托盘（TrayHost），首次打开才创建主窗口；
- Resources 中定义全局隐式样式：统一去掉 Button/CheckBox/RadioButton/
  ComboBox/TextBox 获得键盘焦点时显示的虚线框，使界面观感更现代。
============================================================================ -->
<!-- 根元素 Application：x:Class 绑定到代码侧的 App 分部类；local 前缀指向本程序集命名空间 -->
<Application x:Class="TimeActivity.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TimeActivity">
    <!-- 全局资源字典：此处定义的隐式样式会按 TargetType 自动作用于全应用的同类控件 -->
    <Application.Resources>
        <!-- 全局去掉按钮点击后的虚线焦点边框 -->
        <!-- Button 隐式样式：FocusVisualStyle 置 null 即去掉 Tab 键盘导航时的虚线框 -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!-- CheckBox 隐式样式：同上，去掉焦点虚线框 -->
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!-- RadioButton 隐式样式：同上，去掉焦点虚线框 -->
        <Style TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!-- ComboBox 隐式样式：同上，去掉焦点虚线框 -->
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!-- TextBox 隐式样式：同上，去掉焦点虚线框 -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Application.Resources>
</Application>
